# Copy to .env (gitignored) and fill real values.
# SA_PASSWORD: min 8 chars, must contain letters + numbers (per business password rules).
# Connection string consumed by BSC.Api via appsettings.Development.json.

SA_PASSWORD=YourStrong!Passw0rd

# Local dev connection string (matches docker-compose service)
BSC_DB_CONNECTION=Server=localhost,1433;Database=BSC;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;